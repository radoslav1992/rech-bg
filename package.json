{
  "name": "rech-bg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply rech-bg --local",
    "db:remote": "wrangler d1 migrations apply rech-bg --remote",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@elevenlabs/elevenlabs-js": "^2.68.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "hono": "^4.12.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.56.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "stripe": "^20.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20260910.0-alpha",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.71.0"
  }
}
