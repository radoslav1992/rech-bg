{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rech-bg",
  "main": "server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "routes": [{ "pattern": "rechbg.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "ai": { "binding": "AI" },
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["info@rechbg.com"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rech-bg",
      "database_id": "4916f5c6-41cd-48a9-ba0e-25e2554701b4",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "rech-bg-audio" }],
  "workflows": [
    {
      "name": "rech-bg-generation",
      "binding": "GENERATION",
      "class_name": "AudioGeneration",
    },
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 120000 },
}
